# --- Review layer (optional, for client review builds only) -------------------
# Set to 1 to show the "Comment" button that lets reviewers pin notes on any
# element. Leave unset / empty in production.
NEXT_PUBLIC_JOY_REVIEW=

# Where review comments are stored. Without these two values comments are kept
# in the reviewer's own browser (localStorage) only.
# Create the table with supabase/review.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
